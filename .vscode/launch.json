{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug monitoring_service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/monitoring_service",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "envFile": "${workspaceFolder}/monitoring_service/.env",
            "jinja": true,
            "justMyCode": true
        }
    ]
}
